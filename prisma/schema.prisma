// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One brand voice profile per shop. Used to steer every generation.
model BrandVoice {
  id         String   @id @default(cuid())
  shop       String   @unique
  brandName  String   @default("")
  tone       String   @default("friendly")
  audience   String   @default("")
  length     String   @default("medium")
  language   String   @default("English")
  keywords   String   @default("")
  avoidWords String   @default("")
  updatedAt  DateTime @updatedAt
}

// Every AI draft, so merchants can review, apply and roll back.
model Generation {
  id                String    @id @default(cuid())
  shop              String
  productId         String
  productTitle      String
  previousHtml      String
  previousSeoTitle  String?
  previousSeoDesc   String?
  descriptionHtml   String
  seoTitle          String
  seoDescription    String
  highlights        String    @default("[]")
  model             String
  // draft | applied | replaced (a newer draft went live) | reverted | discarded
  status            String    @default("draft")
  createdAt         DateTime  @default(now())
  appliedAt         DateTime?
  // The description as Shopify saved it on apply. Set only for drafts applied
  // since this column was added, so undo knows it has something reliable to
  // compare the live product with (older rows hold the HTML that was sent).
  appliedHtml       String?
  // Drafts applied together from the review queue share a batch, so they can
  // be undone together.
  batchId           String?

  @@index([shop, productId])
  @@index([shop, createdAt])
  @@index([shop, batchId])
  @@index([shop, status])
}

// A run of work the background worker carries out, such as writing drafts
// for many products. It keeps going after the merchant closes the app.
model Job {
  id          String    @id @default(cuid())
  shop        String
  kind        String // draft (later: alt_text, collection, translate)
  // queued | running | done | cancelled (no new items start, but running
  // ones finish; finishedAt is set once nothing is left running)
  status      String    @default("queued")
  total       Int
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  // Set when the merchant closes the progress banner, so it stops showing.
  dismissedAt DateTime?
  items       JobItem[]

  @@index([shop, status])
  @@index([shop, createdAt])
}

model JobItem {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Copied from the job so the worker can share slots fairly between shops.
  shop       String
  position   Int // order the merchant chose
  resourceId String // product GID
  title      String
  status     String    @default("queued") // queued | running | done | failed | cancelled
  error      String?
  resultId   String? // Generation id
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now()) // a retry waits, and plan 09 can delay an item
  lockedBy   String? // id of the worker that claimed it
  lockedAt   DateTime? // refreshed while it runs, so a stale lock means a dead worker

  @@index([jobId, position])
  @@index([status, runAfter])
  @@index([lockedBy])
}

// Recurring work (a nightly catalog rescan, a metrics pull). When one is due,
// the worker runs its handler, which queues ordinary jobs.
model ScheduledTask {
  id              String   @id @default(cuid())
  name            String
  shop            String? // null for app-wide tasks
  nextRunAt       DateTime
  intervalMinutes Int

  @@index([nextRunAt])
  @@index([name, shop])
}
